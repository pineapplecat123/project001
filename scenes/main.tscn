[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Center" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -160.0
offset_top = -120.0
offset_right = 160.0
offset_bottom = 120.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="Center"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "project001"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center"]
layout_mode = 2
text = "灰盒战斗（无地图）"
horizontal_alignment = 1

[node name="BtnStart" type="Button" parent="Center"]
unique_name_in_owner = true
layout_mode = 2
text = "开始战斗"

[node name="BtnQuit" type="Button" parent="Center"]
unique_name_in_owner = true
layout_mode = 2
text = "退出"

[node name="VersionLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -80.0
offset_top = -40.0
offset_right = 80.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 0
text = "v0.1.3"
horizontal_alignment = 1

[connection signal="pressed" from="Center/BtnStart" to="." method="_on_start_pressed"]
[connection signal="pressed" from="Center/BtnQuit" to="." method="_on_quit_pressed"]
